{
  "name": "dsh-chat-shell",
  "version": "0.5.0",
  "description": "Chat/Harness switch for DeepSeek Harness: embed DeepSeek, Doubao or ChatGPT in the whole window, and switch back to Harness in one click.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "chatgpt",
    "doubao",
    "desktop",
    "webview"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxg103/dsh-chat-shell.git"
  },
  "bugs": {
    "url": "https://github.com/lxg103/dsh-chat-shell/issues"
  },
  "homepage": "https://github.com/lxg103/dsh-chat-shell#readme"
}
